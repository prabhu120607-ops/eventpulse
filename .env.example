# EventPulse Environment Configuration
DEBUG=True
SECRET_KEY=eventpulse-insecure-dev-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/eventpulse_db

# Email Configuration
# Default for development: console backend (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=EventPulse Notifications <notifications@eventpulse.univ.edu>

# Production SMTP settings (Uncomment and configure for real email delivery):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_api_key_here

# Optional LLM API Key for advanced feedback summaries (Works without key via built-in NLP heuristics)
# OPENAI_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
